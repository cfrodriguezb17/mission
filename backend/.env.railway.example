# Referencias para Variables en Railway. No copiar a backend/.env local.
# Los servicios de base de datos deben llamarse Postgres y Redis.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=GENERAR_UN_SECRETO_EN_RAILWAY
DJANGO_ALLOWED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}},healthcheck.railway.app
POSTGRES_DB=${{Postgres.PGDATABASE}}
POSTGRES_USER=${{Postgres.PGUSER}}
POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
POSTGRES_HOST=${{Postgres.PGHOST}}
POSTGRES_PORT=${{Postgres.PGPORT}}
DJANGO_REDIS_URL=${{Redis.REDIS_URL}}
DJANGO_REALTIME_REDIS_URL=${{Redis.REDIS_URL}}
DJANGO_DB_CONN_MAX_AGE=0
DJANGO_DB_POOL=true
DJANGO_DB_POOL_MIN_SIZE=1
DJANGO_DB_POOL_MAX_SIZE=4
DJANGO_DB_PREPARE_THRESHOLD=5
DJANGO_ASGI_SYNC_REST=true
DJANGO_ASGI_HTTP_LIMIT=16
DJANGO_ASGI_HTTP_QUEUE=64
DJANGO_ASGI_ADMISSION_WAIT_MS=500
DJANGO_ASGI_WEBSOCKET_LIMIT=1024
DJANGO_ASGI_STREAM_LIMIT=16
WEB_CONCURRENCY=2
DJANGO_THROTTLE_REDIS=true
DJANGO_THROTTLE_CACHE_PREFIX=datapulse:throttle:production
DJANGO_DATA_CACHE_TTL=60
DJANGO_DATA_CACHE_PREFIX=datapulse:data:production
DJANGO_REALTIME_PREFIX=datapulse:realtime:production
CORS_ALLOWED_ORIGINS=https://REEMPLAZAR_DOMINIO_FRONTEND
CSRF_TRUSTED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_TRUST_PROXY=true
# Mantener 0 hasta comprobar la cadena de proxies real del servicio.
DJANGO_NUM_PROXIES=0
REST_COUNTRIES_API_KEY=
