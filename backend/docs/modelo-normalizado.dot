Alerta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#bccadb" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#17324f"><FONT COLOR="white"><B>Alerta</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id: BigAuto</FONT></TD></TR><TR><TD PORT="usuario" ALIGN="LEFT"><FONT POINT-SIZE="10">FK usuario: ForeignKey</FONT></TD></TR><TR><TD PORT="pais" ALIGN="LEFT"><FONT POINT-SIZE="10">FK pais: ForeignKey</FONT></TD></TR><TR><TD PORT="tipo_alerta" ALIGN="LEFT"><FONT POINT-SIZE="10">tipo_alerta: Char</FONT></TD></TR><TR><TD PORT="severidad" ALIGN="LEFT"><FONT POINT-SIZE="10">severidad: Char</FONT></TD></TR><TR><TD PORT="titulo" ALIGN="LEFT"><FONT POINT-SIZE="10">titulo: Char</FONT></TD></TR><TR><TD PORT="mensaje" ALIGN="LEFT"><FONT POINT-SIZE="10">mensaje: Text</FONT></TD></TR><TR><TD PORT="fecha_creacion" ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_creacion: DateTime</FONT></TD></TR><TR><TD PORT="clave_evento" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ clave_evento: Char</FONT></TD></TR><TR><TD PORT="detalle" ALIGN="LEFT"><FONT POINT-SIZE="10">detalle: JSON</FONT></TD></TR></TABLE>>];
