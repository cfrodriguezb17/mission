Moneda -> Pais:moneda [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
Pais -> IndicadorEconomico:pais [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
TipoIndicador -> IndicadorEconomico:tipo [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
Moneda -> TipoCambio:moneda_origen [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
Moneda -> TipoCambio:moneda_destino [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
User -> Portafolio:usuario [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
Portafolio -> Posicion:portafolio [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
Pais -> Posicion:pais [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
Pais -> IndiceRiesgo:pais [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
User -> Alerta:usuario [dir=both, arrowtail=tee, arrowhead=crow, taillabel="0..1", headlabel="N"];
Pais -> Alerta:pais [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
User -> LecturaAlerta:usuario [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
Alerta -> LecturaAlerta:alerta [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
User -> LogActividad:usuario [dir=both, arrowtail=tee, arrowhead=crow, taillabel="0..1", headlabel="N"];
}