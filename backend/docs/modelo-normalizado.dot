digraph ER { graph [rankdir=LR, bgcolor="transparent", nodesep=0.35, ranksep=1.1];
node [shape=plain, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=9, color="#758aa3"];
User [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#bccadb" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#17324f"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id: BigAuto</FONT></TD></TR><TR><TD PORT="password" ALIGN="LEFT"><FONT POINT-SIZE="10">password: Char</FONT></TD></TR><TR><TD PORT="last_login" ALIGN="LEFT"><FONT POINT-SIZE="10">last_login: DateTime</FONT></TD></TR><TR><TD PORT="is_superuser" ALIGN="LEFT"><FONT POINT-SIZE="10">is_superuser: Boolean</FONT></TD></TR><TR><TD PORT="is_staff" ALIGN="LEFT"><FONT POINT-SIZE="10">is_staff: Boolean</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ email: Char</FONT></TD></TR><TR><TD PORT="nombre_completo" ALIGN="LEFT"><FONT POINT-SIZE="10">nombre_completo: Char</FONT></TD></TR><TR><TD PORT="rol" ALIGN="LEFT"><FONT POINT-SIZE="10">rol: Char</FONT></TD></TR><TR><TD PORT="fecha_creacion" ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_creacion: DateTime</FONT></TD></TR><TR><TD PORT="is_active" ALIGN="LEFT"><FONT POINT-SIZE="10">is_active: Boolean</FONT></TD></TR></TABLE>>];
