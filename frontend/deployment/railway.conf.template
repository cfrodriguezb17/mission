server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /health/ {
        access_log off;
        default_type application/json;
        return 200 '{"estado":"ok"}';
    }

    # Business requests go directly to the HTTPS API configured at build time.
    # Do not hide a wrong API URL behind the SPA fallback.
    location /api/ { return 404; }
    location /ws/ { return 404; }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
