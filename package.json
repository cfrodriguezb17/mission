{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "map:generate": "node tools/build-map.mjs",
    "test:unit": "ng test --watch=false --include '**/*.unit.spec.ts'",
    "test:integration": "ng test --watch=false --include '**/*.integration.spec.ts'",
    "test:pyramid": "pnpm test:unit && pnpm test:integration && pnpm test:e2e"
  },
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/material-icons": "^5.3.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.19.2",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "world-atlas": "^2.0.2"
  }
}
